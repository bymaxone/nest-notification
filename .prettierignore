# The lockfile is generated by pnpm and rewritten on every install. Formatting it
# with Prettier strips the blank lines pnpm emits, so the file flips between two
# shapes — one written by `pnpm install`, one by the pre-commit hook — turning
# every dependency change into a whole-file diff.
pnpm-lock.yaml

# Build, coverage and report output is generated, never reviewed.
dist/
coverage/
reports/

# Copied byte for byte from the shared script template (`bymaxone/.github`, script-templates/
# check-function-length), which is what lets every repository carry the same gate. Reformatting it
# here would make this copy differ from the template.
scripts/check-function-length.mjs

# Copied byte for byte from the shared template; Prettier would rewrite it.
scripts/commitlint-no-ai-attribution.cjs

# Copied byte for byte from the shared template (script-templates/check-dist-fresh); Prettier would rewrite them.
scripts/check-dist-fresh.mjs
scripts/check-dist-fresh.test.mjs
