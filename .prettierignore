# The lockfile is generated by pnpm and rewritten on every install. Formatting it
# with Prettier strips the blank lines pnpm emits, so the file flips between two
# shapes — one written by `pnpm install`, one by the pre-commit hook — turning
# every dependency change into a whole-file diff.
pnpm-lock.yaml

# Build, coverage and report output is generated, never reviewed.
dist/
coverage/
reports/
